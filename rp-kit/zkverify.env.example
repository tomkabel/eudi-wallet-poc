# systemd EnvironmentFile syntax; use absolute paths. No shell expansion.
ADDR=127.0.0.1:8080
BASE_URL=https://rp.example.ee
CLIENT_ID=x509_san_dns:rp.example.ee
REGISTRY=/etc/zkverify/circuits.json
ISSUERS=/etc/zkverify/issuers.json
# Empty accepts an operator-managed unsigned local trust store; set this to
# a P-256 public PEM to verify a signed store and enforce freshness (B3).
TRUST_ROOT=
SESSION_TTL=3m
MAX_CONCURRENT_VERIFY=1
DRAIN_TIMEOUT=6m
# Disabled by default; set an exact HTTPS browser origin to enable DCAPI.
DCAPI_ORIGIN=
